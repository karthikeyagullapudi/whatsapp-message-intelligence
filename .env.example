# ---- Server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CLIENT_ORIGIN=http://localhost:5173

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/wa_intelligence

# ---- AI (Gemini) ----
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=30000
AI_MAX_RPM=10
AI_CONCURRENCY=2
AI_MAX_ATTEMPTS=3
APP_TIMEZONE=Asia/Kolkata

# ---- Review rules ----
CONFIDENCE_THRESHOLD=0.75

# ---- WhatsApp ----
WA_CLIENT_ID=main
WA_BACKUP_SYNC_MS=300000
WA_HEADLESS=true
WA_BACKFILL_LIMIT=50
# PUPPETEER_EXECUTABLE_PATH=
